# GBblox marketplace APIs — set these in Vercel → Project → Settings → Environment Variables
# (Production, Preview, Development). Server reads them; browser values in Settings are fallback only.

# Rebrickable  https://rebrickable.com/api/
REBRICKABLE_API_KEY=

# eBay UK Trading API  https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_USER_TOKEN=
# Aliases: EBAY_APP_ID, EBAY_CERT_ID, EBAY_USER_REFRESH_TOKEN
# IAF user access tokens expire ~2 hours. Set EBAY_REFRESH_TOKEN (18 months) so the app can mint a new IAF token automatically.

# BrickLink Store API  https://www.bricklink.com/v3/api.page
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=

# Royal Mail Click & Drop (OLP)  https://business.parcel.royalmail.com/
ROYAL_MAIL_API_KEY=
ROYAL_MAIL_SENDER_NAME=
# Aliases: ROYALMAIL_API_KEY, CLICK_AND_DROP_API_KEY
